{
  "version": 1,
  "description": "Zigbee Silabs ZCL demo data",
  "category": "zigbee",
  "xmlRoot": ".",
  "xmlFile": [
    "ami-devices.xml",
    "ami.xml",
    "cba-devices.xml",
    "cba.xml",
    "general.xml",
    "green-power-devices.xml",
    "green-power.xml",
    "ha-devices.xml",
    "ha.xml",
    "hc-devices.xml",
    "hc.xml",
    "lo-devices.xml",
    "ota.xml",
    "sample-extensions.xml",
    "silabs.xml",
    "ta.xml",
    "ta-devices.xml",
    "types.xml",
    "wwah-silabs-devices.xml",
    "wwah-silabs.xml",
    "z3-nfr.xml",
    "zigbee-direct.xml",
    "zll-devices.xml",
    "zll.xml"
  ],
  "zclSchema": "../shared/schema/zcl.xsd",
  "supportCustomZclDevice": true,
  "manufacturersXml": "manufacturers.xml",
  "profilesXml": "profiles.xml",
  "options": {
    "text": {
      "defaultResponsePolicy": ["Always", "Conditional", "Never"]
    },
    "bool": ["commandDiscovery"]
  },
  "defaults": {
    "text": {
      "manufacturerCodes": "0x1049",
      "defaultResponsePolicy": "always"
    },
    "bool": {
      "commandDiscovery": true
    }
  },
  "ZCLDataTypes": ["ARRAY", "BITMAP", "ENUM", "NUMBER", "STRING", "STRUCT"],
  "uiOptions": {
    "showProfileId": true
  },
  "zcl": {
    "multiProtocol": {
      "category": ["zigbee", "matter"],
      "type": "boolean",
      "configurability": "hidden",
      "globalDefault": false,
      "label": "List of clusters and attributes associated across protocols",
      "defaults": "multi-protocol.json"
    }
  }
}
